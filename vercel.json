{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/tournaments",
      "destination": "/api/tournaments"
    },
    {
      "source": "/api/credentials",
      "destination": "/api/credentials"
    },
    {
      "source": "/api/send-email",
      "destination": "/api/send-email"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
